# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Models (defaults shown). The analyzer runs on every question, so keep it small and fast.
ANALYZER_MODEL=claude-haiku-5-5
ANSWER_MODEL=claude-sonnet-5-5

# Retrieval tuning. Lower MIN_SCORE = answers more, refuses less. Tune with `make eval`.
MIN_SCORE=1.0
TOP_K=5

# 1 enables GET /api/debug/search for tuning retrieval
DEBUG=0

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
