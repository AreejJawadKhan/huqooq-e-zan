# Copy to .env and fill in at least ONE key. Never commit .env.
# Free options: Gemini (https://aistudio.google.com/apikey) and Groq (https://console.groq.com/keys).
# Free tiers may use prompts to improve the provider's products: use synthetic demo questions only.
GEMINI_API_KEY=
GROQ_API_KEY=
# Paid, optional
ANTHROPIC_API_KEY=

# Which provider answers first: gemini | groq | anthropic. Empty = the first one that has a key.
LLM_PROVIDER=
# Comma-separated providers to try if the first one fails (rate limit, outage). Empty = any other provider with a key.
LLM_FALLBACK=

# Model overrides (defaults live in backend/app/providers.py). Model names get retired without warning: after
# changing any of them, or if answers suddenly fail, run `python scripts/check_models.py`.
# GEMINI_ANALYZER_MODEL=gemini-3.5-flash-lite
# GEMINI_ANSWER_MODEL=gemini-3.5-flash
# GROQ_ANALYZER_MODEL=openai/gpt-oss-20b
# GROQ_ANSWER_MODEL=openai/gpt-oss-120b

# Retrieval tuning. Lower MIN_SCORE = answers more, refuses less. Tune with `make eval`.
MIN_SCORE=1.0
TOP_K=5

# 1 enables GET /api/debug/search for tuning retrieval
DEBUG=0

# 1 serves pre-computed answers for the rehearsed demo questions (build with `make demo-cache`)
DEMO_CACHE=0

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
